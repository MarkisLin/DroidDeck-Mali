@@ -315,6 +399,25 @@ PFN_vkVoidFunction
 panvk_GetInstanceProcAddr(VkInstance _instance, const char *pName)
 {
    VK_FROM_HANDLE(panvk_instance, instance, _instance);
+
+   /* Vulkan 1.4 promoted these commands to core, but panvk implements them
+    * under their VK_KHR_maintenance6 spellings. Applications that follow the
+    * 1.4 spec ask for the core name and would otherwise get NULL. Map the
+    * core spelling onto the implementation that exists. */
+   static const struct {
+      const char *core;
+      const char *alias;
+   } promoted_to_khr[] = {
+      {"vkCmdBindDescriptorSets2", "vkCmdBindDescriptorSets2KHR"},
+      {"vkCmdPushConstants2", "vkCmdPushConstants2KHR"},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(promoted_to_khr); i++) {
+      if (strcmp(pName, promoted_to_khr[i].core) == 0) {
+         pName = promoted_to_khr[i].alias;
+         break;
+      }
+   }
+
    return vk_instance_get_proc_addr(&instance->vk, &panvk_instance_entrypoints,
                                     pName);
 }
