#!/bin/bash
# droiddeck-steam-x11 — 在 sway 的 Xwayland 上起 Steam（GamePad UI + 软件 CEF）
# 客户端应用完更新会自己退出一次，这里按"UI 是否真的起来"决定重试，避免无脑重启造成闪烁。
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
ST="${XDG_DATA_HOME:-$HOME/.local/share}/Steam"

for _ in $(seq 1 30); do
  [ -S /tmp/.X11-unix/X0 ] && break
  sleep 1
done

export DISPLAY=:0
export XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb SDL_VIDEODRIVER=x11
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
export STEAM_RUNTIME=1
export LD_LIBRARY_PATH="$ST/steamrtarm64:$ST/steamrtarm64/panorama${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

echo "== droiddeck-steam-x11 $(date) DISPLAY=$DISPLAY"
FLAGS=(-gamepadui -steamdeck -steamos3
       -cef-enable-debugging -devtools-port 22616
       -cef-disable-gpu -cef-disable-gpu-sandbox
       -cef-disable-seccomp-sandbox -cef-disable-sandbox
       -cef-ozone-platform=x11 -language schinese)

start_client() {
  "$ST/steamrtarm64/steam" "${FLAGS[@]}" 2>&1 &
  echo $!
}

ui_alive() { curl -s -m 1 "http://127.0.0.1:22616/json/version" >/dev/null 2>&1; }

attempt=0
while [ "$attempt" -lt 6 ]; do
  attempt=$((attempt + 1))
  pid=$(start_client)
  echo "== attempt $attempt client pid=$pid"
  shown=0
  i=0
  while [ "$i" -lt 90 ]; do
    sleep 1
    i=$((i + 1))
    if ui_alive; then shown=1; break; fi
    kill -0 "$pid" 2>/dev/null || break
  done
  if [ "$shown" = 1 ]; then
    echo "== ui is up (attempt $attempt, ${i}s) — holding"
    wait "$pid"
    echo "== client exited (attempt $attempt)"
    break
  fi
  echo "== no ui (attempt $attempt, ${i}s) — restarting"
  kill "$pid" 2>/dev/null
  sleep 3
done
echo "== droiddeck-steam-x11 done $(date)"
